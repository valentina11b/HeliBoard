<?xml version="1.0" encoding="utf-8"?>
<!-- Used for normal, functional, action and space keys; each is tinted with its own theme color. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Empty background keys. -->
    <item android:state_empty="true" android:state_pressed="true"
          android:drawable="@drawable/btn_keyboard_key_pressed_mechanical" />
    <item android:state_empty="true"
          android:drawable="@android:color/transparent" />

    <item android:state_pressed="true"
          android:drawable="@drawable/btn_keyboard_key_pressed_mechanical" />
    <item android:drawable="@drawable/btn_keyboard_key_normal_mechanical" />
</selector>
